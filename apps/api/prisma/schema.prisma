// TeamSphere data model. See SOURCE_OF_TRUTH.md §7; module tables are added per phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  entra
  ldap
}

enum UserRole {
  admin
  user
  guest
}

model User {
  id             String       @id @default(cuid())
  username       String       @unique
  email          String?      @unique
  passwordHash   String?
  /// How the account was first created. Linked sign-in methods live in UserIdentity.
  authProvider   AuthProvider @default(local)
  displayName    String
  avatarKey      String?
  jobTitle       String?
  department     String?
  office         String?
  phone          String?
  managerId      String?
  manager        User?        @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]       @relation("Manager")
  role           UserRole     @default(user)
  isActive       Boolean      @default(true)
  /// Anonymous meeting guests (role guest): the one meeting this account may use. Null for everyone else.
  guestMeetingId String?

  teamMemberships    TeamMember[]
  channelMemberships ChannelMember[]
  tagMemberships     TagMember[]

  /// Manually chosen presence; null means automatic (available while connected).
  presenceStatus    String?
  presenceExpiresAt DateTime?
  statusMessage     String?
  statusExpiresAt   DateTime?

  /// Out of office: active while enabled and now is within [oooStartAt, oooEndAt) (open ends allowed).
  oooEnabled Boolean   @default(false)
  oooMessage String?
  oooStartAt DateTime?
  oooEndAt   DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions   Session[]
  identities UserIdentity[]
  auditLogs  AuditLog[]

  conversationMembers ConversationMember[]
  messages            Message[]            @relation("MessageAuthor")
  reactions           Reaction[]
  mentions            Mention[]
  attachments         Attachment[]
  notifications       Notification[]       @relation("NotificationUser")
  actedNotifications  Notification[]       @relation("NotificationActor")
  savedMessages       SavedMessage[]
  chatSections        ChatSection[]
  scheduledMessages   ScheduledMessage[]
  pollVotes           PollVote[]

  callsStarted       Call[]            @relation("CallStarter")
  callsTransferred   Call[]            @relation("CallTransferrer")
  callParticipations CallParticipant[] @relation("CallParticipantUser")
  callForwardsFor    CallParticipant[] @relation("CallForwardedFor")
  voicemails         Voicemail[]       @relation("VoicemailRecipient")
  voicemailsLeft     Voicemail[]       @relation("VoicemailSender")
  callSettings       CallSettings?     @relation("CallSettingsOwner")
  callForwardTargets CallSettings[]    @relation("CallForwardTo")
  callAlsoRingFor    CallSettings[]    @relation("CallAlsoRing")
  speedDials         SpeedDial[]       @relation("SpeedDialOwner")
  speedDialedBy      SpeedDial[]       @relation("SpeedDialContact")
}

/// A directory sign-in linked to a user. One person can have both an AD and an Entra identity (hybrid AD).
model UserIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  /// Entra `oid` claim or AD `objectGUID` (hex).
  externalId String
  createdAt  DateTime     @default(now())

  @@unique([provider, externalId])
  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------- Phase 1: chat

enum ConversationType {
  direct
  group
  self
  /// A team channel's posts (Phase 2). Members are synced from the channel's access list by TeamsService.
  channel
}

enum MessageType {
  text
  system
}

enum Importance {
  normal
  important
  urgent
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  title         String?
  /// Direct chats: the two user ids sorted and joined with ":", so each pair has exactly one chat.
  directKey     String?          @unique
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())

  members           ConversationMember[]
  messages          Message[]
  attachments       Attachment[]
  notifications     Notification[]
  scheduledMessages ScheduledMessage[]
  calls             Call[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  /// Messages after this point count as unread.
  lastReadAt     DateTime?
  /// Set when the member was added without chat history; earlier messages are hidden from them.
  historySince   DateTime?
  muted          Boolean      @default(false)
  pinned         Boolean      @default(false)
  hidden         Boolean      @default(false)
  /// "Mark as unread" on the whole chat; cleared by the next read.
  markedUnread   Boolean      @default(false)
  sectionId      String?
  section        ChatSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Last out-of-office auto-reply this member's absence triggered in the chat (at most one a day).
  oooRepliedAt   DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Quoted reply target.
  parentId       String?
  parent         Message?     @relation("Reply", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Reply")
  type           MessageType  @default(text)
  /// Markdown-lite text; mentions are encoded as @[Display Name](userId).
  body           String
  importance     Importance   @default(normal)
  /// Unfurled preview of the first link in the body (LinkPreview DTO), filled in after sending.
  linkPreview    Json?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  reactions     Reaction[]
  mentions      Mention[]
  attachments   Attachment[]
  notifications Notification[]
  savedBy       SavedMessage[]
  poll          Poll?

  @@index([conversationId, createdAt])
}

model SavedMessage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId, createdAt])
}

/// A custom section ("folder") in one person's chat list.
model ChatSection {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  members   ConversationMember[]

  @@index([userId])
}

/// Held until `sendAt`, then posted as a normal message by the scheduler.
model ScheduledMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  parentId       String?
  importance     Importance   @default(normal)
  attachmentIds  String[]
  sendAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([sendAt])
  @@index([authorId, conversationId])
}

model Poll {
  id        String     @id @default(cuid())
  messageId String     @unique
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  multiple  Boolean    @default(false)
  closedAt  DateTime?
  votes     PollVote[]
}

model PollVote {
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int
  createdAt DateTime @default(now())

  @@id([pollId, userId, option])
}

model Reaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
}

model Mention {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Attachment {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null until the message that carries it is sent.
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId     String
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  size           Int
  storageKey     String       @unique
  createdAt      DateTime     @default(now())

  @@index([messageId])
}

/// Activity feed entries: mentions, replies, reactions (later: missed calls, team adds, app events).
model Notification {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type           String
  actorId        String?
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  preview        String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Phase 2: teams & channels
// Channel posts reuse Conversation/Message (Conversation.type = channel; Message.parentId = thread root).
// Channel.conversationId and ChannelPost.messageId are plain ids (no Prisma relation) so the chat models stay untouched.

enum TeamVisibility {
  public
  private
  orgwide
}

enum TeamRole {
  owner
  member
  guest
}

enum ChannelType {
  standard
  private
  shared
}

model Team {
  id          String         @id @default(cuid())
  name        String
  description String?
  visibility  TeamVisibility @default(private)
  /// Code anyone can use to join (owners generate or reset it); null when disabled.
  joinCode    String?        @unique
  /// TeamSettings DTO (member/guest permissions, @team/@channel mentions).
  settings    Json           @default("{}")
  createdById String?
  archivedAt  DateTime?
  /// Soft delete: restorable for 30 days, then purged.
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members        TeamMember[]
  channels       Channel[]
  tags           Tag[]
  sharedChannels ChannelShare[]

  @@index([visibility])
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(member)
  joinedAt DateTime @default(now())
  /// Personal order in the teams list (ascending) and visibility.
  position Int      @default(0)
  hidden   Boolean  @default(false)

  @@id([teamId, userId])
  @@index([userId])
}

model Channel {
  id             String      @id @default(cuid())
  teamId         String
  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           ChannelType @default(standard)
  /// Every team has exactly one General channel; it can't be renamed, archived or deleted.
  isGeneral      Boolean     @default(false)
  conversationId String      @unique
  /// ChannelModeration DTO.
  moderation     Json        @default("{}")
  /// Notes tab: a co-owned markdown page. `notesVersion` guards against overwriting someone else's edit.
  notes          String      @default("")
  notesVersion   Int         @default(0)
  notesUpdatedAt DateTime?
  notesUpdatedBy String?
  createdById    String?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members ChannelMember[]
  shares  ChannelShare[]
  posts   ChannelPost[]

  @@index([teamId])
}

/// Explicit members of private and shared channels (standard channels include the whole team).
model ChannelMember {
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | member
  role      String   @default("member")
  addedAt   DateTime @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

/// A shared channel made available to every member of another team.
model ChannelShare {
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([channelId, teamId])
  @@index([teamId])
}

/// Extra data for a channel's top-level post (the thread root message).
model ChannelPost {
  messageId          String   @id
  channelId          String
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  subject            String?
  announcement       Boolean  @default(false)
  /// Attachment shown as the announcement banner (excluded from the post's file list).
  headerAttachmentId String?
  /// Same id on every copy of a cross-posted message.
  crossPostId        String?
  createdAt          DateTime @default(now())

  @@index([channelId])
  @@index([crossPostId])
}

/// Named group of team members that can be @mentioned together.
model Tag {
  id        String      @id @default(cuid())
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  members   TagMember[]

  @@unique([teamId, name])
}

model TagMember {
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- Phase 3: calls

enum CallKind {
  audio
  video
}

enum CallStatus {
  ringing
  active
  ended
  missed
  declined
}

enum CallParticipantStatus {
  ringing
  joined
  left
  declined
  missed
  busy
  forwarded
}

enum ForwardMode {
  off
  user
  voicemail
}

/// One call = one LiveKit room. Started from a direct or group chat (meetings come in Phase 5).
model Call {
  id                String        @id @default(cuid())
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kind              CallKind
  status            CallStatus    @default(ringing)
  /// hangup | no_answer | declined | busy | dnd | voicemail | transferred | cancelled
  endReason         String?
  roomName          String        @unique
  startedById       String
  startedBy         User          @relation("CallStarter", fields: [startedById], references: [id], onDelete: Cascade)
  /// Set on the new call created by a blind transfer.
  transferredById   String?
  transferredBy     User?         @relation("CallTransferrer", fields: [transferredById], references: [id], onDelete: SetNull)
  transferredFromId String?
  createdAt         DateTime      @default(now())
  /// First time someone other than the caller joined; call duration counts from here.
  answeredAt        DateTime?
  endedAt           DateTime?

  participants CallParticipant[]
  voicemails   Voicemail[]

  @@index([status])
  @@index([conversationId, createdAt])
}

model CallParticipant {
  callId         String
  call           Call                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation("CallParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  status         CallParticipantStatus
  isCaller       Boolean               @default(false)
  onHold         Boolean               @default(false)
  /// Ringing on behalf of this user (call forwarding / simultaneous ring).
  forwardedForId String?
  forwardedFor   User?                 @relation("CallForwardedFor", fields: [forwardedForId], references: [id], onDelete: SetNull)
  /// Start of the current ring; ringing older than RING_TIMEOUT_MS becomes missed.
  invitedAt      DateTime              @default(now())
  joinedAt       DateTime?
  leftAt         DateTime?

  @@id([callId, userId])
  @@index([userId, invitedAt])
  @@index([status, invitedAt])
}

/// Internal voicemail: audio recorded by a caller whose call was missed.
model Voicemail {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("VoicemailRecipient", fields: [userId], references: [id], onDelete: Cascade)
  fromUserId String?
  fromUser   User?     @relation("VoicemailSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  callId     String?
  call       Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  storageKey String    @unique
  mimeType   String
  size       Int
  durationMs Int
  listenedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Per-user call forwarding / simultaneous ring. No row = ring normally.
model CallSettings {
  userId      String      @id
  user        User        @relation("CallSettingsOwner", fields: [userId], references: [id], onDelete: Cascade)
  forwardMode ForwardMode @default(off)
  forwardToId String?
  forwardTo   User?       @relation("CallForwardTo", fields: [forwardToId], references: [id], onDelete: SetNull)
  alsoRingId  String?
  alsoRing    User?       @relation("CallAlsoRing", fields: [alsoRingId], references: [id], onDelete: SetNull)
  updatedAt   DateTime    @updatedAt
}

model SpeedDial {
  userId    String
  user      User     @relation("SpeedDialOwner", fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   User     @relation("SpeedDialContact", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, contactId])
}

// ---------------------------------------------------------------- Phase 6: files
// User ids below are plain columns without relations: libraries can belong to users, teams or channels, and
// keeping this block free of back-relations on User lets it merge independently of other modules.

enum FileOwnerType {
  user
  team
  channel
}

enum FileItemKind {
  file
  folder
}

enum FileShareRole {
  view
  edit
}

enum FileAccessRequestStatus {
  pending
  approved
  denied
}

/// A file or folder in a library identified by (ownerType, ownerId): a user's "My files", a team or a channel.
model FileItem {
  id           String        @id @default(cuid())
  ownerType    FileOwnerType
  ownerId      String
  /// Null at the library root.
  parentId     String?
  parent       FileItem?     @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileItem[]    @relation("FileTree")
  kind         FileItemKind
  name         String
  /// Current version's content (files only); every version, including the current one, is in FileVersion.
  mimeType     String?
  size         Int           @default(0)
  version      Int           @default(1)
  storageKey   String?
  createdById  String?
  modifiedById String?
  createdAt    DateTime      @default(now())
  modifiedAt   DateTime      @default(now())
  /// Soft delete. Set on the deleted item and all its descendants with the same timestamp, so restoring
  /// brings back exactly what was deleted together.
  deletedAt    DateTime?
  deletedById  String?
  /// True only on the item the user deleted: the recycle bin lists these.
  inRecycleBin Boolean       @default(false)

  versions FileVersion[]
  shares   FileShare[]
  links    ShareLink[]
  requests FileAccessRequest[]
  recents  FileRecent[]

  @@index([ownerType, ownerId, parentId])
  @@index([parentId])
  @@index([inRecycleBin, deletedAt])
}

model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  file        FileItem @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version     Int
  /// Restoring an old version adds a new version pointing at the same object, so keys are not unique.
  storageKey  String
  size        Int
  mimeType    String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([fileId, version])
}

/// Specific-people sharing. Sharing a folder grants the same access to everything inside it.
model FileShare {
  id          String        @id @default(cuid())
  itemId      String
  item        FileItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  role        FileShareRole
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([itemId, userId])
  @@index([userId])
}

/// "People in your organization with the link". Anyone signed in who opens the link gets `role`.
model ShareLink {
  id          String         @id @default(cuid())
  itemId      String
  item        FileItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  token       String         @unique
  role        FileShareRole
  createdById String?
  createdAt   DateTime       @default(now())
  revokedAt   DateTime?
  uses        ShareLinkUse[]

  @@index([itemId])
}

/// Who has opened a link: lists the item under "Shared with me". Access ends when the link is revoked.
model ShareLinkUse {
  linkId    String
  link      ShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId    String
  firstUsed DateTime  @default(now())

  @@id([linkId, userId])
  @@index([userId])
}

model FileAccessRequest {
  id          String                  @id @default(cuid())
  itemId      String
  item        FileItem                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requesterId String
  role        FileShareRole
  message     String?
  status      FileAccessRequestStatus @default(pending)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())

  @@index([itemId, status])
  @@index([requesterId])
}

model FileRecent {
  userId     String
  itemId     String
  item       FileItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  accessedAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([userId, accessedAt])
}

// ---------------------------------------------------------------- Phase 5a: meetings & calendar
// Like the files block, user ids are plain columns (no back-relations on User) so this block merges on its own.
// The meeting chat is a regular group Conversation (or the chat a "Meet now" started from).

enum MeetingRole {
  organizer
  coorganizer
  presenter
  attendee
}

enum MeetingRsvp {
  none
  accepted
  tentative
  declined
}

model Meeting {
  id             String    @id @default(cuid())
  organizerId    String
  title          String
  description    String    @default("")
  location       String    @default("")
  /// First occurrence; for a series every occurrence lasts endAt - startAt.
  startAt        DateTime
  endAt          DateTime
  /// IANA zone the recurrence is expanded in (so "9:00 every Monday" survives DST).
  timeZone       String    @default("UTC")
  /// Recurrence rule (shared `recurrenceSchema`), null for a single meeting.
  recurrence     Json?
  /// Per-occurrence overrides keyed by the original start ISO: { cancelled?, startAt?, endAt?, rsvp? }.
  exceptions     Json      @default("{}")
  joinCode       String    @unique
  options        Json      @default("{}")
  conversationId String
  channelId      String?
  /// meeting | webinar | townhall | appointment (only meeting for now).
  kind           String    @default("meeting")
  isInstant      Boolean   @default(false)
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendees  MeetingAttendee[]
  sessions   MeetingSession[]
  recordings Recording[]
  polls      MeetingPoll[]
  questions  MeetingQuestion[]
  whiteboard MeetingWhiteboard?

  @@index([conversationId])
  @@index([startAt])
}

model MeetingAttendee {
  meetingId       String
  meeting         Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId          String
  role            MeetingRole @default(attendee)
  required        Boolean     @default(true)
  rsvp            MeetingRsvp @default(none)
  rsvpNote        String?
  proposedStartAt DateTime?
  proposedEndAt   DateTime?
  createdAt       DateTime    @default(now())

  @@id([meetingId, userId])
  @@index([userId])
}

/// One time people were in the meeting room (one per occurrence that someone joined). Lobby/hands live in memory.
model MeetingSession {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  occurrenceStart DateTime
  roomName        String    @unique
  locked          Boolean   @default(false)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  attendance MeetingAttendance[]

  @@index([meetingId, endedAt])
}

/// One join → leave interval of one user (rejoining adds a row). Fed by LiveKit webhooks and room polling.
model MeetingAttendance {
  id        String         @id @default(cuid())
  sessionId String
  session   MeetingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  role      MeetingRole
  joinedAt  DateTime       @default(now())
  leftAt    DateTime?

  @@index([sessionId, userId])
}

model WorkingHours {
  userId      String   @id
  timeZone    String
  /// Weekdays, 0 = Sunday.
  days        Int[]
  startMinute Int
  endMinute   Int
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------- Phase 5b: meetings advanced

enum RecordingStatus {
  recording
  processing
  ready
  failed
}

/// One LiveKit Egress room-composite recording (MP4 in S3). Deleted (row + object) after expiresAt.
model Recording {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sessionId   String
  egressId    String?         @unique
  storageKey  String
  status      RecordingStatus @default(recording)
  startedById String
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  durationSec Int?
  size        BigInt?
  error       String?
  expiresAt   DateTime

  @@index([meetingId])
  @@index([expiresAt])
}

enum MeetingPollStatus {
  draft
  live
  closed
}

/// Meeting poll: pre-created as a draft, launched live during the meeting, then closed (results stay).
model MeetingPoll {
  id          String            @id @default(cuid())
  meetingId   String
  meeting     Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  question    String
  options     String[]
  multiple    Boolean           @default(false)
  anonymous   Boolean           @default(false)
  status      MeetingPollStatus @default(draft)
  createdById String
  createdAt   DateTime          @default(now())
  launchedAt  DateTime?
  closedAt    DateTime?
  votes       MeetingPollVote[]

  @@index([meetingId])
}

model MeetingPollVote {
  pollId    String
  poll      MeetingPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  option    Int
  createdAt DateTime    @default(now())

  @@id([pollId, userId, option])
}

enum MeetingQuestionStatus {
  pending
  published
  answered
  dismissed
}

/// Q&A: attendee questions wait as pending until an organizer publishes them (when moderated); upvotes rank them.
model MeetingQuestion {
  id        String                @id @default(cuid())
  meetingId String
  meeting   Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  anonymous Boolean               @default(false)
  status    MeetingQuestionStatus @default(pending)
  createdAt DateTime              @default(now())
  votes     MeetingQuestionVote[]

  @@index([meetingId])
}

model MeetingQuestionVote {
  questionId String
  question   MeetingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String

  @@id([questionId, userId])
}

/// The meeting whiteboard as a Yjs document update (Y.encodeStateAsUpdate), co-edited over Socket.IO.
model MeetingWhiteboard {
  meetingId String   @id
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  state     Bytes
  updatedAt DateTime @updatedAt
}
