{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev"
      ],
      "port": 4001
    },
    {
      "name": "api-calls",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "dev"
      ],
      "port": 4002
    },
    {
      "name": "web-calls",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "exec",
        "next",
        "dev",
        "--port",
        "4003"
      ],
      "port": 4003,
      "env": {
        "API_URL": "http://127.0.0.1:4002",
        "NEXT_PUBLIC_SOCKET_PORT": "4002"
      }
    },
    {
      "name": "api-files",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "dev"
      ],
      "port": 4006
    },
    {
      "name": "web-files",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "exec",
        "next",
        "dev",
        "--port",
        "4007"
      ],
      "port": 4007,
      "env": {
        "API_URL": "http://127.0.0.1:4006",
        "NEXT_PUBLIC_SOCKET_PORT": "4006"
      }
    }
  ]
}
