# Copy to .env for local development. Values below match infra/docker-compose.yml.
PORT=4600
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://teamsphere:teamsphere@127.0.0.1:5433/teamsphere?schema=public
REDIS_URL=redis://127.0.0.1:6380

# Generate long random values in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=teamsphere
S3_SECRET_KEY=teamsphere-secret
S3_BUCKET=teamsphere

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars_long

# --- Microsoft Entra ID (OIDC) ---
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must match the redirect URI registered in Entra. Goes through the web app's /api proxy.
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback

# --- On-prem Active Directory (LDAP) ---
LDAP_ENABLED=false
LDAP_LABEL=Company directory
LDAP_URL=ldaps://dc01.company.local:636
LDAP_BIND_DN=CN=svc-teamsphere,OU=Service Accounts,DC=company,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=company,DC=local
# {{username}} is replaced with the escaped login name.
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
# Members of this group become TeamSphere admins (optional, full DN).
LDAP_ADMIN_GROUP_DN=
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Chat link previews ---
LINK_PREVIEWS_ENABLED=true
# Allow previews of intranet (private IP) links. Off by default so chat links cannot probe internal services.
LINK_PREVIEW_ALLOW_PRIVATE=false

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=TeamSphere <no-reply@teamsphere.local>

# Development seed accounts (prisma/seed.ts). Test-only values.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345
