// TeamSphere data model. See SOURCE_OF_TRUTH.md §7; module tables are added per phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  entra
  ldap
}

enum UserRole {
  admin
  user
  guest
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String?      @unique
  passwordHash String?
  /// How the account was first created. Linked sign-in methods live in UserIdentity.
  authProvider AuthProvider @default(local)
  displayName  String
  avatarKey    String?
  jobTitle     String?
  department   String?
  office       String?
  phone        String?
  managerId    String?
  manager      User?        @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]       @relation("Manager")
  role         UserRole     @default(user)
  isActive     Boolean      @default(true)

  /// Manually chosen presence; null means automatic (available while connected).
  presenceStatus    String?
  presenceExpiresAt DateTime?
  statusMessage     String?
  statusExpiresAt   DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions   Session[]
  identities UserIdentity[]
  auditLogs  AuditLog[]

  conversationMembers ConversationMember[]
  messages            Message[]            @relation("MessageAuthor")
  reactions           Reaction[]
  mentions            Mention[]
  attachments         Attachment[]
  notifications       Notification[]       @relation("NotificationUser")
  actedNotifications  Notification[]       @relation("NotificationActor")
}

/// A directory sign-in linked to a user. One person can have both an AD and an Entra identity (hybrid AD).
model UserIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  /// Entra `oid` claim or AD `objectGUID` (hex).
  externalId String
  createdAt  DateTime     @default(now())

  @@unique([provider, externalId])
  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------- Phase 1: chat

enum ConversationType {
  direct
  group
  self
}

enum MessageType {
  text
  system
}

enum Importance {
  normal
  important
  urgent
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  title         String?
  /// Direct chats: the two user ids sorted and joined with ":", so each pair has exactly one chat.
  directKey     String?          @unique
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())

  members       ConversationMember[]
  messages      Message[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  /// Messages after this point count as unread.
  lastReadAt     DateTime?
  /// Set when the member was added without chat history; earlier messages are hidden from them.
  historySince   DateTime?
  muted          Boolean      @default(false)
  pinned         Boolean      @default(false)
  hidden         Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Quoted reply target.
  parentId       String?
  parent         Message?     @relation("Reply", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Reply")
  type           MessageType  @default(text)
  /// Markdown-lite text; mentions are encoded as @[Display Name](userId).
  body           String
  importance     Importance   @default(normal)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  reactions     Reaction[]
  mentions      Mention[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([conversationId, createdAt])
}

model Reaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
}

model Mention {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Attachment {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null until the message that carries it is sent.
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId     String
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  size           Int
  storageKey     String       @unique
  createdAt      DateTime     @default(now())

  @@index([messageId])
}

/// Activity feed entries: mentions, replies, reactions (later: missed calls, team adds, app events).
model Notification {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type           String
  actorId        String?
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  preview        String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Phase 6: files
// User ids below are plain columns without relations: libraries can belong to users, teams or channels, and
// keeping this block free of back-relations on User lets it merge independently of other modules.

enum FileOwnerType {
  user
  team
  channel
}

enum FileItemKind {
  file
  folder
}

enum FileShareRole {
  view
  edit
}

enum FileAccessRequestStatus {
  pending
  approved
  denied
}

/// A file or folder in a library identified by (ownerType, ownerId): a user's "My files", a team or a channel.
model FileItem {
  id           String        @id @default(cuid())
  ownerType    FileOwnerType
  ownerId      String
  /// Null at the library root.
  parentId     String?
  parent       FileItem?     @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileItem[]    @relation("FileTree")
  kind         FileItemKind
  name         String
  /// Current version's content (files only); every version, including the current one, is in FileVersion.
  mimeType     String?
  size         Int           @default(0)
  version      Int           @default(1)
  storageKey   String?
  createdById  String?
  modifiedById String?
  createdAt    DateTime      @default(now())
  modifiedAt   DateTime      @default(now())
  /// Soft delete. Set on the deleted item and all its descendants with the same timestamp, so restoring
  /// brings back exactly what was deleted together.
  deletedAt    DateTime?
  deletedById  String?
  /// True only on the item the user deleted: the recycle bin lists these.
  inRecycleBin Boolean       @default(false)

  versions FileVersion[]
  shares   FileShare[]
  links    ShareLink[]
  requests FileAccessRequest[]
  recents  FileRecent[]

  @@index([ownerType, ownerId, parentId])
  @@index([parentId])
  @@index([inRecycleBin, deletedAt])
}

model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  file        FileItem @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version     Int
  /// Restoring an old version adds a new version pointing at the same object, so keys are not unique.
  storageKey  String
  size        Int
  mimeType    String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([fileId, version])
}

/// Specific-people sharing. Sharing a folder grants the same access to everything inside it.
model FileShare {
  id          String        @id @default(cuid())
  itemId      String
  item        FileItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  role        FileShareRole
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([itemId, userId])
  @@index([userId])
}

/// "People in your organization with the link". Anyone signed in who opens the link gets `role`.
model ShareLink {
  id          String         @id @default(cuid())
  itemId      String
  item        FileItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  token       String         @unique
  role        FileShareRole
  createdById String?
  createdAt   DateTime       @default(now())
  revokedAt   DateTime?
  uses        ShareLinkUse[]

  @@index([itemId])
}

/// Who has opened a link: lists the item under "Shared with me". Access ends when the link is revoked.
model ShareLinkUse {
  linkId    String
  link      ShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId    String
  firstUsed DateTime  @default(now())

  @@id([linkId, userId])
  @@index([userId])
}

model FileAccessRequest {
  id          String                  @id @default(cuid())
  itemId      String
  item        FileItem                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requesterId String
  role        FileShareRole
  message     String?
  status      FileAccessRequestStatus @default(pending)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())

  @@index([itemId, status])
  @@index([requesterId])
}

model FileRecent {
  userId     String
  itemId     String
  item       FileItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  accessedAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([userId, accessedAt])
}
