// TeamSphere data model. See SOURCE_OF_TRUTH.md §7; module tables are added per phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  entra
  ldap
}

enum UserRole {
  admin
  user
  guest
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String?      @unique
  passwordHash String?
  /// How the account was first created. Linked sign-in methods live in UserIdentity.
  authProvider AuthProvider @default(local)
  displayName  String
  avatarKey    String?
  jobTitle     String?
  department   String?
  office       String?
  phone        String?
  managerId    String?
  manager      User?        @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]       @relation("Manager")
  role         UserRole     @default(user)
  isActive     Boolean      @default(true)

  teamMemberships    TeamMember[]
  channelMemberships ChannelMember[]
  tagMemberships     TagMember[]

  /// Manually chosen presence; null means automatic (available while connected).
  presenceStatus    String?
  presenceExpiresAt DateTime?
  statusMessage     String?
  statusExpiresAt   DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions   Session[]
  identities UserIdentity[]
  auditLogs  AuditLog[]

  conversationMembers ConversationMember[]
  messages            Message[]            @relation("MessageAuthor")
  reactions           Reaction[]
  mentions            Mention[]
  attachments         Attachment[]
  notifications       Notification[]       @relation("NotificationUser")
  actedNotifications  Notification[]       @relation("NotificationActor")
}

/// A directory sign-in linked to a user. One person can have both an AD and an Entra identity (hybrid AD).
model UserIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  /// Entra `oid` claim or AD `objectGUID` (hex).
  externalId String
  createdAt  DateTime     @default(now())

  @@unique([provider, externalId])
  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------- Phase 1: chat

enum ConversationType {
  direct
  group
  self
  /// A team channel's posts (Phase 2). Members are synced from the channel's access list by TeamsService.
  channel
}

enum MessageType {
  text
  system
}

enum Importance {
  normal
  important
  urgent
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  title         String?
  /// Direct chats: the two user ids sorted and joined with ":", so each pair has exactly one chat.
  directKey     String?          @unique
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())

  members       ConversationMember[]
  messages      Message[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  /// Messages after this point count as unread.
  lastReadAt     DateTime?
  /// Set when the member was added without chat history; earlier messages are hidden from them.
  historySince   DateTime?
  muted          Boolean      @default(false)
  pinned         Boolean      @default(false)
  hidden         Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Quoted reply target.
  parentId       String?
  parent         Message?     @relation("Reply", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Reply")
  type           MessageType  @default(text)
  /// Markdown-lite text; mentions are encoded as @[Display Name](userId).
  body           String
  importance     Importance   @default(normal)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  reactions     Reaction[]
  mentions      Mention[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([conversationId, createdAt])
}

model Reaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
}

model Mention {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Attachment {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null until the message that carries it is sent.
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId     String
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  size           Int
  storageKey     String       @unique
  createdAt      DateTime     @default(now())

  @@index([messageId])
}

/// Activity feed entries: mentions, replies, reactions (later: missed calls, team adds, app events).
model Notification {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type           String
  actorId        String?
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  preview        String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Phase 2: teams & channels
// Channel posts reuse Conversation/Message (Conversation.type = channel; Message.parentId = thread root).
// Channel.conversationId and ChannelPost.messageId are plain ids (no Prisma relation) so the chat models stay untouched.

enum TeamVisibility {
  public
  private
  orgwide
}

enum TeamRole {
  owner
  member
  guest
}

enum ChannelType {
  standard
  private
  shared
}

model Team {
  id          String         @id @default(cuid())
  name        String
  description String?
  visibility  TeamVisibility @default(private)
  /// Code anyone can use to join (owners generate or reset it); null when disabled.
  joinCode    String?        @unique
  /// TeamSettings DTO (member/guest permissions, @team/@channel mentions).
  settings    Json           @default("{}")
  createdById String?
  archivedAt  DateTime?
  /// Soft delete: restorable for 30 days, then purged.
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members        TeamMember[]
  channels       Channel[]
  tags           Tag[]
  sharedChannels ChannelShare[]

  @@index([visibility])
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(member)
  joinedAt DateTime @default(now())
  /// Personal order in the teams list (ascending) and visibility.
  position Int      @default(0)
  hidden   Boolean  @default(false)

  @@id([teamId, userId])
  @@index([userId])
}

model Channel {
  id             String      @id @default(cuid())
  teamId         String
  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           ChannelType @default(standard)
  /// Every team has exactly one General channel; it can't be renamed, archived or deleted.
  isGeneral      Boolean     @default(false)
  conversationId String      @unique
  /// ChannelModeration DTO.
  moderation     Json        @default("{}")
  /// Notes tab: a co-owned markdown page. `notesVersion` guards against overwriting someone else's edit.
  notes          String      @default("")
  notesVersion   Int         @default(0)
  notesUpdatedAt DateTime?
  notesUpdatedBy String?
  createdById    String?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members ChannelMember[]
  shares  ChannelShare[]
  posts   ChannelPost[]

  @@index([teamId])
}

/// Explicit members of private and shared channels (standard channels include the whole team).
model ChannelMember {
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | member
  role      String   @default("member")
  addedAt   DateTime @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

/// A shared channel made available to every member of another team.
model ChannelShare {
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([channelId, teamId])
  @@index([teamId])
}

/// Extra data for a channel's top-level post (the thread root message).
model ChannelPost {
  messageId          String   @id
  channelId          String
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  subject            String?
  announcement       Boolean  @default(false)
  /// Attachment shown as the announcement banner (excluded from the post's file list).
  headerAttachmentId String?
  /// Same id on every copy of a cross-posted message.
  crossPostId        String?
  createdAt          DateTime @default(now())

  @@index([channelId])
  @@index([crossPostId])
}

/// Named group of team members that can be @mentioned together.
model Tag {
  id        String      @id @default(cuid())
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  members   TagMember[]

  @@unique([teamId, name])
}

model TagMember {
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
}
