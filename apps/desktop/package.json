{
  "name": "@teamsphere/desktop",
  "productName": "TeamSphere",
  "version": "0.1.0",
  "private": true,
  "description": "TeamSphere for Windows",
  "author": "TeamSphere",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "start": "pnpm build && electron . --server=http://localhost:4001",
    "dist": "pnpm build && electron-builder --win --x64 --publish never",
    "dist:dir": "pnpm build && electron-builder --win --x64 --dir --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@teamsphere/shared": "workspace:*",
    "@types/node": "^22.18.0",
    "electron": "~44.10.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.4",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
